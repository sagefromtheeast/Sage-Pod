+    boostMillibels = millibels
+    applyVolumeBoost()
+  }
+
+  private fun applyVolumeBoost() {
+    if (boostMillibels <= 0) {
+      releaseVolumeBoost()
+      return
+    }
+    // Until the player has its own session, wait for onAudioSessionIdChanged.
+    val sessionId = ref.audioSessionId
+    if (sessionId == C.AUDIO_SESSION_ID_UNSET) return
+    try {
+      val enhancer = loudnessEnhancer ?: LoudnessEnhancer(sessionId).also { loudnessEnhancer = it }
+      enhancer.setTargetGain(boostMillibels)
+      enhancer.enabled = true
+    } catch (e: RuntimeException) {
+      // Some devices refuse audio effects; play at normal volume instead.
+      Log.w(TAG, "Volume boost unavailable", e)
+      releaseVolumeBoost()
+    }
+  }
+
+  private fun releaseVolumeBoost() {
+    loudnessEnhancer?.release()
+    loudnessEnhancer = null
+  }
